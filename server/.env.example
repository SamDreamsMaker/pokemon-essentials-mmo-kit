# Copy to server/.env and edit. docker-compose reads it automatically.
# NEVER commit the real .env (it is gitignored).

# Postgres password for the bundled db service + the server's DATABASE_URL.
POSTGRES_PASSWORD=change_me

# Public TCP port the game clients connect to.
PEMK_PORT=9998

# The protections, all off by default. Ramp one at a time (off -> shadow -> on),
# as docs/GETTING-STARTED.md describes. Uncomment what you enable.
# PEMK_FLAG_STATE=shadow
# PEMK_FLAG_ENFORCE=shadow
# PEMK_GIFT_ENFORCE=shadow
# PEMK_PEER_CHECK=shadow
# PEMK_SHOP_ENFORCE=shadow
# Logs every item increase no server-known source explains (shadow only for now).
# PEMK_ITEM_AUTHORITY=shadow
# Items a plugin's own code gives, which the exports cannot see: never judged.
# PEMK_ITEM_LOCAL=MYITEM,OTHERITEM
# Money: prizes and Pay Day claimed and judged (shadow logs; on pays them itself and
# refuses money it cannot explain, once the boot names no blocker).
# PEMK_MONEY_AUTHORITY=shadow
# The day's allowances (dollars): Pay Day, sales of items the server never judged, and
# battles fought again. Defaults 20000, 10000, 20000.
# PEMK_MONEY_PAYDAY_DAILY=20000
# PEMK_MONEY_LOCAL_DAILY=10000
# PEMK_MONEY_REPEAT_DAILY=20000
# A trainer's prize paid on its battle's replay (needs PEMK_BATTLE_ENFORCE_RNG=on and
# the replay daemon; on also needs money enforcement). What no replay can prove is paid
# from PEMK_MONEY_UNPROVEN_DAILY a day (default 5000).
# PEMK_TRAINER_PROOF=shadow
# PEMK_MONEY_UNPROVEN_DAILY=5000
# On by default, not a protection to ramp: a traded Pokemon the receiver never saved
# (a crash, a lost result) is sent again. off turns it off.
# PEMK_TRADE_REDELIVERY=off
# Also on by default: the PC storage and held items come back at login from the
# server's record with the bag (a crash can no longer duplicate a moved item).
# PEMK_ITEM_RECORD=bag
# PEMK_POS_ENFORCE=shadow
# PEMK_PICKUP_ENFORCE=on
# PEMK_BATTLE_ENFORCE_TEAMS=shadow
# PEMK_BATTLE_ENFORCE_ENCOUNTERS=on
# PEMK_BATTLE_ENFORCE_CATCHES=shadow
# PEMK_BATTLE_ENFORCE_REWARDS=shadow
# PEMK_BATTLE_ENFORCE_EXP=shadow
# PEMK_BATTLE_ENFORCE_RNG=shadow
# PEMK_BATTLE_ENFORCE_RESIM=shadow
# PEMK_ANOMALY_DETECTION=on
